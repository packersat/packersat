{
  "redirects": [
    { "source": "/portal/index.html", "destination": "/portal", "permanent": true }
  ],
  "rewrites": [
    { "source": "/portal", "destination": "/portal/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.packersat.org" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/session-log-reminder",
      "schedule": "0 1 * * *"
    }
  ]
}
